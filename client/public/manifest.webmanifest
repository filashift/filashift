{
  "name": "FilaShift — 3MF printer converter",
  "short_name": "FilaShift",
  "description": "Convert 3MF projects between Bambu Lab, Flashforge, Snapmaker, Creality and other printers. Files stay on your device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6fa",
  "theme_color": "#0033C2",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [{ "action": "/", "accept": { "model/3mf": [".3mf"] } }]
}

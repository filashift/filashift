# Replace plateshift.example.com with your domain. Caddy gets the HTTPS certificate automatically.
plateshift.example.com {
	root * /var/www/plateshift
	encode zstd gzip
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@profiles path /profiles/*
	header @profiles Cache-Control "public, max-age=86400"
	header /index.html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

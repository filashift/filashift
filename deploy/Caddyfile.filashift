{
	# account email for Let's Encrypt and the ZeroSSL backup issuer (ZeroSSL requires one)
	email support@jacksoncgc.com
}

(site) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# filament prices and site config, refreshed by filashift-filament.timer (kept outside the release folder)
	handle_path /data/* {
		root * /var/www/filashift-data
		header Cache-Control "public, max-age=300"
		file_server
	}

	# report-a-problem inbox (deploy/filashift-api.py)
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/plateshift
		redir /filament/ /filament permanent
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@profiles path /profiles/*
		header @profiles Cache-Control "public, max-age=86400"
		# app pages such as /filament are served by index.html
		@spa {
			not file
			not path *.*
		}
		header @spa Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		rewrite @spa /index.html
		file_server
	}
}

# HTTPS certificates are issued automatically once DNS points here
filashift.com {
	import site
	header Strict-Transport-Security "max-age=31536000"
}

www.filashift.com {
	redir https://filashift.com{uri} permanent
}

# plain IP access keeps working
:80 {
	import site
}

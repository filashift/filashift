{
	# account email for Let's Encrypt and the ZeroSSL backup issuer (ZeroSSL requires one)
	email support@jacksoncgc.com
}

(site) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-4GB+togjbPOstglo9IUDssYkVTQmkJw1vfTbs0dWDAk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# filament prices and site config, refreshed by filashift-filament.timer (kept outside the release folder)
	handle_path /data/* {
		root * /var/www/filashift-data
		header Cache-Control "public, max-age=300"
		file_server
	}

	# report-a-problem inbox (deploy/filashift-api.py)
	handle /api/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/plateshift
		# forgive links pasted with chat leftovers stuck on the end, e.g. /filament[filashift] or /guides).
		@pastejunk path_regexp pastejunk `^(/[^\[\]]*?)(\[[^\]]*\]|[\)\].,;:!'"]+)$`
		redir @pastejunk {re.pastejunk.1}{?query} permanent
		redir /filament/ /filament permanent
		# RFC 9116 security contact: client/public/.well-known/security.txt (file_server serves dot-directories)
		redir /security.txt /.well-known/security.txt permanent
		header /.well-known/security.txt Content-Type "text/plain; charset=utf-8"
		# localized copies (/es/, /de/, /fr/) are prerendered to /<lang>/<route>/index.html and use the same rules;
		# their home pages are canonical with the trailing slash. Unknown /es/, /de/ and /fr/ paths get
		# that language's 404 page, other unknown paths the English one (both with status 404, see @missing below).
		redir /es /es/{?query} permanent
		redir /de /de/{?query} permanent
		redir /fr /fr/{?query} permanent
		redir /es/filament/ /es/filament permanent
		redir /de/filament/ /de/filament permanent
		redir /fr/filament/ /fr/filament permanent
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@profiles path /profiles/*
		header @profiles Cache-Control "public, max-age=86400"
		# pages are prerendered to /<route>/index.html; anything else gets the 404 page with a real 404 status
		@page {
			not file
			file {path}/index.html
		}
		@html path *.html /
		header @html Cache-Control "no-cache"
		header @page Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		header /sitemap.xml Cache-Control "public, max-age=3600"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		rewrite @page {path}/index.html
		@missing {
			not file
			not file {path}/index.html
		}
		handle @missing {
			header Cache-Control "no-cache"
			# translated not-found pages for the localized prefixes; /it/, /xx/ and the rest get the English one
			rewrite /es/* /es/404.html
			rewrite /de/* /de/404.html
			rewrite /fr/* /fr/404.html
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		file_server
	}
}

# HTTPS certificates are issued automatically once DNS points here
filashift.com {
	import site
	header Strict-Transport-Security "max-age=31536000"
}

www.filashift.com {
	redir https://filashift.com{uri} permanent
}

# plain IP access keeps working
:80 {
	import site
}

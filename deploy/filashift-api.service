[Unit]
Description=FilaShift report inbox (/api)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/filashift/filashift-api.py
User=caddy
Group=caddy
StateDirectory=filashift
Environment=FILASHIFT_REPORT_DIR=/var/lib/filashift/reports
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/filashift
MemoryMax=64M

[Install]
WantedBy=multi-user.target
